{
  "description": "Reverse audio challenge mini program",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": ".git"
      },
      {
        "type": "folder",
        "value": ".cloudbase"
      }
    ],
    "include": []
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
