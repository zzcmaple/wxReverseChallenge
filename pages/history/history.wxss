.panel {
  margin-top: 24rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #e7eef0;
}

.record-item:last-child {
  border-bottom: none;
}

.item-main {
  flex: 1;
  padding-right: 20rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #23313f;
}

.item-meta {
  margin-top: 10rpx;
  color: #76848d;
  font-size: 24rpx;
}

.item-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
}

.item-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status-processing {
  background: #fff6df;
  color: #b57900;
}

.status-done {
  background: #effaf7;
  color: #168f84;
}

.status-failed {
  background: #fff1f4;
  color: #d84b69;
}

.delete-btn {
  margin: 0;
  min-width: 120rpx;
}
