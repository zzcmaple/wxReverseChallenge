.panel {
  margin-top: 24rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e8edf6;
}

.record-item:last-child {
  border-bottom: none;
}

.item-main {
  flex: 1;
  padding-right: 20rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #15233d;
}

.item-meta {
  margin-top: 12rpx;
  color: #75839d;
  font-size: 24rpx;
}

.item-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
}

.item-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status-processing {
  background: #fff5de;
  color: #a67d13;
}

.status-done {
  background: #edfaf2;
  color: #287857;
}

.status-failed {
  background: #fff0f0;
  color: #bf4648;
}

.delete-btn {
  margin: 0;
}
