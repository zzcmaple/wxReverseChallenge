<view class="page-shell">
  <view class="panel">
    <view class="title">历史记录</view>
    <view class="subtitle">每一次倒放挑战都会留在这里。</view>
  </view>

  <view class="panel list-panel" wx:if="{{records.length}}">
    <view
      wx:for="{{records}}"
      wx:key="_id"
      class="record-item"
      bindtap="goDetail"
      data-id="{{item._id}}"
    >
      <view class="item-main">
        <view class="item-title">{{item.title}}</view>
        <view class="item-meta">{{item.durationText}} · {{item.createdAtText}}</view>
      </view>
      <view class="item-side">
        <view class="item-status status-{{item.status}}">{{item.statusText}}</view>
        <button
          class="danger-btn delete-btn"
          size="mini"
          catchtap="deleteRecord"
          data-id="{{item._id}}"
          loading="{{deletingId === item._id}}"
          disabled="{{deletingId === item._id}}"
        >
          删除
        </button>
      </view>
    </view>
  </view>

  <view class="panel" wx:else>
    <view class="empty-text">还没有记录，先去录一条试试。</view>
  </view>
</view>
