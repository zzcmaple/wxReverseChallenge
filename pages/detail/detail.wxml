<view class="page-shell">
  <view class="panel detail-panel" wx:if="{{record}}">
    <view class="section-head">原声区</view>
    <view class="simple-row">
      <view class="section-title">原音</view>
      <view class="audio-meta">{{record.durationText}}</view>
    </view>
    <button class="secondary-btn play-btn" bindtap="playOriginal">
      {{playingType === 'original' ? '暂停原音' : '听原音'}}
    </button>

    <view class="audio-divider"></view>

    <view class="simple-row">
      <view class="section-title">倒放版本</view>
      <view class="audio-meta">{{record.durationText}}</view>
    </view>
    <button
      class="primary-btn play-btn"
      bindtap="playReverse"
      disabled="{{record.status !== 'done'}}"
    >
      {{playingType === 'reverse' ? '暂停倒放' : '听倒放'}}
    </button>
    <view class="hint-text" wx:if="{{record.status !== 'done'}}">{{reverseHint}}</view>

    <view class="player-status" wx:if="{{playingType === 'original' || playingType === 'reverse'}}">
      <text>播放中：{{playingType === 'original' ? '原音' : '倒放版本'}}</text>
      <text>{{currentTimeText}} / {{durationText}}</text>
    </view>
  </view>

  <view class="panel mimic-panel" wx:if="{{record}}">
    <view class="section-head">模仿区</view>
    <view class="subtitle mimic-copy">先听原生区的倒放版本，再模仿说出来，最后把你的声音再倒放回去听。</view>
    <view class="record-status {{isMimicRecording ? 'recording' : ''}}">
      <view class="status-dot"></view>
      <text>{{mimicStatusText}}</text>
    </view>
    <view class="time-text mimic-time">{{mimicDurationText}}</view>

    <button
      wx:if="{{!isMimicRecording}}"
      class="primary-btn play-btn"
      bindtap="startMimicRecording"
      loading="{{mimicSubmitting}}"
    >
      开始模仿录音
    </button>
    <button
      wx:else
      class="danger-btn play-btn"
      bindtap="stopMimicRecording"
    >
      结束模仿录音
    </button>

    <view wx:if="{{mimicTempFilePath}}">
      <button class="secondary-btn play-btn" bindtap="playMimicPreview">
        {{isMimicPreviewPlaying ? '暂停试听模仿原音' : '试听模仿原音'}}
      </button>
      <button class="primary-btn play-btn" bindtap="submitMimicAudio" loading="{{mimicSubmitting}}">
        生成倒放版本
      </button>
    </view>
  </view>

  <view class="panel detail-panel" wx:if="{{mimicRecord}}">
    <view class="section-head">模仿结果</view>
    <view class="simple-row">
      <view class="section-title">原音</view>
      <view class="audio-meta">{{mimicRecord.durationText}}</view>
    </view>
    <button class="secondary-btn play-btn" bindtap="playMimicOriginal">
      {{playingType === 'mimicOriginal' ? '暂停原音' : '听原音'}}
    </button>

    <view class="audio-divider"></view>

    <view class="simple-row">
      <view class="section-title">倒放版本</view>
      <view class="audio-meta">{{mimicRecord.durationText}}</view>
    </view>
    <button
      class="primary-btn play-btn"
      bindtap="playMimicReverse"
      disabled="{{mimicRecord.status !== 'done'}}"
    >
      {{playingType === 'mimicReverse' ? '暂停倒放' : '听倒放'}}
    </button>
    <view class="hint-text" wx:if="{{mimicRecord.status !== 'done'}}">{{mimicReverseHint}}</view>

    <view class="player-status" wx:if="{{playingType === 'mimicOriginal' || playingType === 'mimicReverse'}}">
      <text>播放中：{{playingType === 'mimicOriginal' ? '原音' : ' 倒放版本'}}</text>
      <text>{{currentTimeText}} / {{durationText}}</text>
    </view>
  </view>

  <view class="panel action-panel" wx:if="{{record}}">
    <button class="primary-btn page-btn" bindtap="goHistory">查看历史记录</button>
  </view>
</view>
