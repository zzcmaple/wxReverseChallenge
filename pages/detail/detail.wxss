.detail-panel {
  margin-top: 20rpx;
}

.mimic-panel {
  margin-top: 24rpx;
  border-color: rgba(25, 200, 179, 0.25);
}

.section-head {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(25, 200, 179, 0.13);
  color: #168f84;
  font-size: 24rpx;
  font-weight: 800;
  margin-bottom: 22rpx;
}

.simple-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #23313f;
}

.highlight-title {
  color: #149f91;
}

.audio-meta {
  color: #72808a;
  font-size: 24rpx;
}

.mimic-copy {
  margin-top: 0;
}

.record-status {
  margin-top: 24rpx;
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  background: #effaf7;
  color: #168f84;
  border-radius: 999rpx;
  padding: 12rpx 22rpx;
  font-size: 24rpx;
}

.recording {
  background: #fff1f4;
  color: #df4f70;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: currentColor;
}

.mimic-time {
  margin-top: 18rpx;
  font-size: 58rpx;
  font-weight: 800;
  color: #1d2c39;
}

.play-btn {
  width: 100%;
  margin-top: 20rpx;
}

.small-play-btn {
  min-width: 164rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 22rpx;
  margin-top: 18rpx;
  margin-left: 0;
  margin-right: 0;
}

.audio-divider {
  margin: 30rpx 0;
  height: 1rpx;
  background: #e7eef0;
}

.hint-text {
  margin-top: 16rpx;
  color: #77858e;
  font-size: 24rpx;
  line-height: 1.6;
}

.player-status {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #effaf7;
  color: #168f84;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
}

.action-panel {
  margin-top: 24rpx;
}

.page-btn {
  width: 100%;
  margin-top: 18rpx;
}
